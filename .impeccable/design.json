  "narrative": {
    "northStar": "The Gallery and the Catalogue",
    "overview": "REWAP is presented the way a great auction house presents a collection: generous white walls, few works per room, and an exact caption beside each one. Authority comes from composition, precise language and sourced facts rather than ornament. Registry Navy does the work black usually does; bronze is a signature reserved for the mark and hairlines.",
    "keyCharacteristics": [
      "Near-neutral gallery white ground, never cream; navy-tinted ink, never pure black.",
      "Caslon for the voice, Public Sans for facts with tabular figures.",
      "Every image and listing carries a museum wall-label caption.",
      "Square corners, 1 px rules, a single soft lift reserved for menus.",
      "A three-column index margin; reading starts at column four."
    ],
    "rules": [
      {
        "name": "The Five Percent Rule",
        "body": "Bronze covers under five percent of any view.",
        "section": "colors"
      },
      {
        "name": "The No Gold Rule",
        "body": "Bronze is never pushed toward yellow gold, never metallic outside the logo, never fills a button.",
        "section": "colors"
      },
      {
        "name": "The Status-Only Rule",
        "body": "Status colors appear only for status.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Caslon speaks; Public Sans states facts. A price is the one number set in Caslon.",
        "section": "typography"
      },
      {
        "name": "The Four Word Label Rule",
        "body": "Caps-tracked labels never exceed four words and never sit above a heading.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "Only floating UI casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the logo exactly as supplied, from the vector masters, with one roof height of clear space.",
      "Do caption every image like a wall label.",
      "Do set numbers in tabular Public Sans and cite the source and date of every market figure.",
      "Do present every Massachusetts region with equal standing.",
      "Do label sample data and placeholders as such."
    ],
    "donts": [
      "Don't use black with metallic gold, gradient text, glassmorphism or rounded oversized cards.",
      "Don't place eyebrows or kickers above headings.",
      "Don't use stock imagery of keys, handshakes, families on sofas or aerial subdivisions, or AI-generated homes or people.",
      "Don't invent metrics, testimonials or awards.",
      "Don't recolor an affiliated team's mark in REWAP colors or merge team and brokerage names."
    ]
  }
}