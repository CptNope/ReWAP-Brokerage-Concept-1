  "duration": {
    "1": {
      "$type": "duration",
      "$value": "160ms"
    },
    "2": {
      "$type": "duration",
      "$value": "320ms"
    },
    "3": {
      "$type": "duration",
      "$value": "640ms"
    },
    "reveal": {
      "$type": "duration",
      "$value": "1100ms"
    }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "inout": {
      "$type": "cubicBezier",
      "$value": [
        0.65,
        0,
        0.35,
        1
      ]
    }
