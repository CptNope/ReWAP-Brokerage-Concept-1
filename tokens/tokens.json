  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Libre Caslon Display",
        "Georgia",
        "serif"
      ]
    },
    "text": {
      "$type": "fontFamily",
      "$value": [
        "Libre Caslon Text",
        "Georgia",
        "serif"
      ]
    },
    "ui": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "size": {
    "display": {
      "$type": "dimension",
      "$value": "clamp(3rem, 1.9rem + 4.2vw, 6rem)"
    },
    "h1": {
      "$type": "dimension",
      "$value": "clamp(2.5rem, 1.75rem + 2.8vw, 4.25rem)"
    },
    "h2": {
      "$type": "dimension",
      "$value": "clamp(1.875rem, 1.45rem + 1.5vw, 2.75rem)"
    },
    "h3": {
      "$type": "dimension",
      "$value": "clamp(1.375rem, 1.22rem + .55vw, 1.75rem)"
    },
    "lead": {
      "$type": "dimension",
      "$value": "clamp(1.1875rem, 1.08rem + .4vw, 1.4375rem)"
    },
    "body": {
      "$type": "dimension",
      "$value": "1.0625rem"
    },
    "ui": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "small": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "label": {
      "$type": "dimension",
      "$value": "0.75rem"
    }
  },
  "space": {
    "s-1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "s-2": {
      "$type": "dimension",
      "$value": "0.5rem"
